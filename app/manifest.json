{
  "schemaVersion": "2.0.0",
  "acapPackageConf": {
    "setup": {
      "appName": "OpenConnect_VPN",
      "friendlyName": "OpenConnect VPN",
      "vendor": "moshe@mohome.net",
      "vendorId": "70ee172dd9",
      "vendorUrl": "https://github.com/Mo3he/Axis_Cam_OpenConnect",
      "version": "0.1.0",
      "architecture": "BUILDARCH",
      "runMode": "respawn",
      "user": {
        "group": "sdk",
        "username": "sdk"
      },
      "compatibleOsVersions": [{ "min": "11.11", "max": "13" }]
    },
    "configuration": {
      "settingPage": "index.html",
      "reverseProxy": [
        {
          "apiPath": "api",
          "target": "http://localhost:2210/",
          "access": "admin"
        }
      ],
      "paramConfig": [
        { "name": "Enabled", "default": "no", "type": "bool:no,yes" },
        { "name": "Server", "default": "", "type": "string" },
        { "name": "ServerType", "default": "portal", "type": "string" },
        { "name": "Gateway", "default": "", "type": "string" },
        { "name": "Username", "default": "", "type": "string" },
        { "name": "Password", "default": "", "type": "password" },
        { "name": "ServerCert", "default": "", "type": "string" },
        { "name": "ReportedOs", "default": "linux", "type": "string" },
        { "name": "HttpProxyPort", "default": "28080", "type": "string" },
        { "name": "Socks5Port", "default": "21080", "type": "string" },
        { "name": "ForwardPorts", "default": "80,443,554", "type": "string" },
        { "name": "KeepAliveMinutes", "default": "0", "type": "string" }
      ]
    }
  }
}
